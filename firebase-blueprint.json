{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student account profile and personal study preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 160 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "tutorLanguage": { "type": "string", "enum": ["ar-msa", "ar-iq", "en"] },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "fontSize": { "type": "integer" },
        "speechRate": { "type": "number" },
        "voiceName": { "type": "string", "maxLength": 40 },
        "gradeLevel": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "tutorLanguage", "theme", "fontSize", "createdAt", "updatedAt"]
    },
    "Book": {
      "title": "Book",
      "description": "An uploaded textbook or educational document owned by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 240 },
        "subject": { "type": "string", "maxLength": 120 },
        "gradeLevel": { "type": "string", "maxLength": 80 },
        "fileType": { "type": "string", "enum": ["pdf", "pptx", "image", "docx", "txt"] },
        "totalPages": { "type": "integer" },
        "lastPage": { "type": "integer" },
        "completedCount": { "type": "integer" },
        "analyzedCount": { "type": "integer" },
        "analysisStatus": { "type": "string", "enum": ["pending", "analyzing", "ready", "partial", "error"] },
        "coverImage": { "type": "string", "maxLength": 350000 },
        "chapters": { "type": "array" },
        "importantTasks": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "fileType", "totalPages", "lastPage", "completedCount", "analyzedCount", "analysisStatus", "createdAt", "updatedAt"]
    },
    "BookPage": {
      "title": "BookPage",
      "description": "Individual page content, compressed visual image, and AI analysis.",
      "type": "object",
      "properties": {
        "pageNumber": { "type": "integer" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "printedPageLabel": { "type": "string", "maxLength": 40 },
        "chapterTitle": { "type": "string", "maxLength": 200 },
        "imageData": { "type": "string", "maxLength": 750000 },
        "extractedText": { "type": "string", "maxLength": 60000 },
        "concepts": { "type": "array" },
        "diagrams": { "type": "array" },
        "equations": { "type": "array" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "estimatedMinutes": { "type": "integer" },
        "isCompleted": { "type": "boolean" },
        "isAnalyzed": { "type": "boolean" },
        "ocrApplied": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pageNumber", "userId", "bookId", "extractedText", "isCompleted", "isAnalyzed", "updatedAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Personal student note or saved explanation linked to a specific book page.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "maxLength": 240 },
        "chapterTitle": { "type": "string", "maxLength": 200 },
        "pageNumber": { "type": "integer" },
        "noteType": { "type": "string", "enum": ["selection", "explanation", "diagram", "manual"] },
        "title": { "type": "string", "maxLength": 200 },
        "selectedText": { "type": "string", "maxLength": 4000 },
        "content": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "bookId", "bookTitle", "pageNumber", "noteType", "title", "content", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Text chat message between student and AI tutor within a book context.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string", "maxLength": 24000 },
        "pageNumber": { "type": "integer" },
        "chapterTitle": { "type": "string", "maxLength": 200 },
        "selectedText": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "bookId", "role", "text", "pageNumber", "createdAt"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Adaptive multi-book study schedule generated for a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "startDate": { "type": "string", "maxLength": 20 },
        "examDate": { "type": "string", "maxLength": 20 },
        "dailyHours": { "type": "number" },
        "availableDays": { "type": "array" },
        "hardSubjects": { "type": "array" },
        "studyMode": { "type": "string", "enum": ["new", "review", "both"] },
        "bookIds": { "type": "array" },
        "totalTasks": { "type": "integer" },
        "completedTasks": { "type": "integer" },
        "adviceMessage": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "startDate", "examDate", "dailyHours", "studyMode", "totalTasks", "completedTasks", "status", "createdAt", "updatedAt"]
    },
    "StudyTask": {
      "title": "StudyTask",
      "description": "Individual daily task inside a study plan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 20 },
        "bookId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "maxLength": 240 },
        "subject": { "type": "string", "maxLength": 120 },
        "chapterTitle": { "type": "string", "maxLength": 200 },
        "startPage": { "type": "integer" },
        "endPage": { "type": "integer" },
        "estimatedMinutes": { "type": "integer" },
        "actualMinutes": { "type": "integer" },
        "taskType": { "type": "string", "enum": ["study", "review", "quiz", "rest"] },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "skipped"] },
        "orderIndex": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "planId", "date", "bookId", "bookTitle", "startPage", "endPage", "estimatedMinutes", "taskType", "status", "orderIndex", "updatedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Oral or written exam session and final result summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookTitle": { "type": "string", "maxLength": 240 },
        "scopeLabel": { "type": "string", "maxLength": 240 },
        "startPage": { "type": "integer" },
        "endPage": { "type": "integer" },
        "mode": { "type": "string", "enum": ["written", "oral"] },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "selectionStrategy": { "type": "string", "enum": ["comprehensive", "important", "random"] },
        "evaluationMode": { "type": "string", "enum": ["practice", "exam"] },
        "durationMinutes": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "score": { "type": "number" },
        "status": { "type": "string", "enum": ["in_progress", "completed"] },
        "weakTopics": { "type": "array" },
        "coverageWarning": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "bookId", "bookTitle", "scopeLabel", "startPage", "endPage", "mode", "difficulty", "selectionStrategy", "evaluationMode", "totalQuestions", "score", "status", "createdAt", "updatedAt"]
    },
    "ExamQuestion": {
      "title": "ExamQuestion",
      "description": "Question, student answer, and grading feedback inside an exam.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderIndex": { "type": "integer" },
        "questionType": { "type": "string", "enum": ["mcq", "true_false", "definition", "reasoning", "fill_blank", "comparison", "essay", "math", "diagram"] },
        "prompt": { "type": "string", "maxLength": 4000 },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string", "maxLength": 4000 },
        "studentAnswer": { "type": "string", "maxLength": 4000 },
        "transcript": { "type": "string", "maxLength": 4000 },
        "isCorrect": { "type": "boolean" },
        "earnedPoints": { "type": "number" },
        "maxPoints": { "type": "number" },
        "mistakeReason": { "type": "string", "maxLength": 2000 },
        "explanation": { "type": "string", "maxLength": 4000 },
        "sourcePage": { "type": "integer" },
        "topicTitle": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "examId", "orderIndex", "questionType", "prompt", "correctAnswer", "maxPoints", "sourcePage", "updatedAt"]
    },
    "SchoolGrade": {
      "title": "SchoolGrade",
      "description": "Real school class grade recorded by the student to track level and diagnose weak subjects and chapters.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subject": { "type": "string", "maxLength": 120 },
        "examType": { "type": "string", "enum": ["daily", "month1", "month2", "midyear", "final", "other"] },
        "examLabel": { "type": "string", "maxLength": 160 },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "percentage": { "type": "number" },
        "chapterOrTopic": { "type": "string", "maxLength": 200 },
        "bookId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examDate": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "subject", "examType", "examLabel", "score", "maxScore", "percentage", "examDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student profile and settings."
    },
    "/users/{userId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Student uploaded books and study progress."
    },
    "/users/{userId}/books/{bookId}/pages/{pageId}": {
      "schema": { "$ref": "#/entities/BookPage" },
      "description": "Individual pages of a book with visual image and metadata."
    },
    "/users/{userId}/books/{bookId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Text tutoring chat messages for a book."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Student saved notes and explanations."
    },
    "/users/{userId}/studyPlans/{planId}": {
      "schema": { "$ref": "#/entities/StudyPlan" },
      "description": "Adaptive study plans."
    },
    "/users/{userId}/studyPlans/{planId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/StudyTask" },
      "description": "Daily study tasks belonging to a study plan."
    },
    "/users/{userId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Oral and written exam sessions."
    },
    "/users/{userId}/exams/{examId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/ExamQuestion" },
      "description": "Questions and grading details for an exam."
    },
    "/users/{userId}/schoolGrades/{gradeId}": {
      "schema": { "$ref": "#/entities/SchoolGrade" },
      "description": "Student real school class grades organized by subject and exam type."
    }
  }
}
