# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SCHOOL_ADMIN_CODE: First Principal (المدير) access code for «سجل الطالب الذكي».
# Set this in server environment / AI Studio Secrets. Never hardcode a fallback code.
SCHOOL_ADMIN_CODE=""

# SCHOOL_ADMIN_EMAIL: Authorized Google account email for Principal verification.
SCHOOL_ADMIN_EMAIL="bssam07815281649@gmail.com"

# SCHOOL_DATA_DIR: set to an existing persistent mounted volume on a hosted Express server.
# Move existing store.json, .session-secret and backups BEFORE changing the path.
# Example: SCHOOL_DATA_DIR="/data/school-record"
# This does not configure Firestore or replace Firebase authentication.
SCHOOL_DATA_DIR=""

# GEMINI_TEXT_MODEL: Default free-tier economical model ("gemini-3.1-flash-lite" or "gemini-4-hydrogen").
GEMINI_TEXT_MODEL="gemini-3.1-flash-lite"

# Optional daily per-user / per-IP limits to protect free-tier quota (Baghdad midnight reset).
AI_DAILY_LIMIT_GUEST="40"
AI_DAILY_LIMIT_AUTH="80"
AI_DAILY_LIVE_LIMIT_GUEST="8"
AI_DAILY_LIVE_LIMIT_AUTH="15"

