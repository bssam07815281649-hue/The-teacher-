rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      // All authenticated users may access only their own UID namespace, including
      // anonymous tutor guests. Staff privileges are never inferred from this rule.
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    // Entity Validators
    function isValidUserProfile(data, userId) {
      return data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && data.tutorLanguage in ['ar-msa', 'ar-iq', 'en']
        && data.theme in ['light', 'dark']
        && data.fontSize is int
        && data.fontSize >= 14
        && data.fontSize <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'displayName', 160)
        && isOptionalString(data, 'photoURL', 500)
        && isOptionalString(data, 'voiceName', 40)
        && isOptionalString(data, 'gradeLevel', 80)
        && (!('speechRate' in data) || ((data.speechRate is float || data.speechRate is int) && data.speechRate >= 0.5 && data.speechRate <= 2.0));
    }

    function isValidBook(data, userId, bookId) {
      return data.id is string
        && data.id == bookId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 240
        && data.fileType in ['pdf', 'pptx', 'image', 'docx', 'txt']
        && data.totalPages is int
        && data.totalPages >= 1
        && data.totalPages <= 5000
        && data.lastPage is int
        && data.lastPage >= 1
        && data.lastPage <= data.totalPages
        && data.completedCount is int
        && data.completedCount >= 0
        && data.completedCount <= data.totalPages
        && data.analyzedCount is int
        && data.analyzedCount >= 0
        && data.analyzedCount <= data.totalPages
        && data.analysisStatus in ['pending', 'analyzing', 'ready', 'partial', 'error']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'subject', 120)
        && isOptionalString(data, 'gradeLevel', 80)
        && isOptionalString(data, 'coverImage', 350000)
        && (!('chapters' in data) || (data.chapters is list && data.chapters.size() <= 150 && (data.chapters.size() == 0 || data.chapters[0] is map)))
        && (!('importantTasks' in data) || (data.importantTasks is list && data.importantTasks.size() <= 200 && (data.importantTasks.size() == 0 || data.importantTasks[0] is map)));
    }

    function isValidBookPage(data, userId, bookId) {
      return data.pageNumber is int
        && data.pageNumber >= 1
        && data.pageNumber <= 5000
        && data.userId is string
        && data.userId == userId
        && data.bookId is string
        && data.bookId == bookId
        && isValidId(data.bookId)
        && data.extractedText is string
        && data.extractedText.size() <= 60000
        && data.isCompleted is bool
        && data.isAnalyzed is bool
        && data.updatedAt is timestamp
        && isOptionalString(data, 'printedPageLabel', 40)
        && isOptionalString(data, 'chapterTitle', 200)
        && isOptionalString(data, 'imageData', 750000)
        && (!('difficulty' in data) || data.difficulty in ['easy', 'medium', 'hard'])
        && (!('estimatedMinutes' in data) || (data.estimatedMinutes is int && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 180))
        && (!('ocrApplied' in data) || data.ocrApplied is bool)
        && (!('concepts' in data) || (data.concepts is list && data.concepts.size() <= 40 && (data.concepts.size() == 0 || data.concepts[0] is string)))
        && (!('diagrams' in data) || (data.diagrams is list && data.diagrams.size() <= 30 && (data.diagrams.size() == 0 || data.diagrams[0] is string)))
        && (!('equations' in data) || (data.equations is list && data.equations.size() <= 40 && (data.equations.size() == 0 || data.equations[0] is string)));
    }

    function isValidNote(data, userId, noteId) {
      return data.id is string
        && data.id == noteId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.bookId is string
        && isValidId(data.bookId)
        && data.bookTitle is string
        && data.bookTitle.size() >= 1
        && data.bookTitle.size() <= 240
        && data.pageNumber is int
        && data.pageNumber >= 1
        && data.pageNumber <= 5000
        && data.noteType in ['selection', 'explanation', 'diagram', 'manual']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 20000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'chapterTitle', 200)
        && isOptionalString(data, 'selectedText', 4000);
    }

    function isValidChatMessage(data, userId, bookId, messageId) {
      return data.id is string
        && data.id == messageId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.bookId is string
        && data.bookId == bookId
        && isValidId(data.bookId)
        && data.role in ['user', 'assistant']
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 24000
        && data.pageNumber is int
        && data.pageNumber >= 1
        && data.pageNumber <= 5000
        && data.createdAt is timestamp
        && isOptionalString(data, 'chapterTitle', 200)
        && isOptionalString(data, 'selectedText', 4000);
    }

    function isValidStudyPlan(data, userId, planId) {
      return data.id is string
        && data.id == planId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.startDate is string
        && data.startDate.size() >= 8
        && data.startDate.size() <= 20
        && data.examDate is string
        && data.examDate.size() >= 8
        && data.examDate.size() <= 20
        && (data.dailyHours is float || data.dailyHours is int)
        && data.dailyHours >= 0.5
        && data.dailyHours <= 16
        && data.studyMode in ['new', 'review', 'both']
        && data.totalTasks is int
        && data.totalTasks >= 0
        && data.totalTasks <= 500
        && data.completedTasks is int
        && data.completedTasks >= 0
        && data.completedTasks <= 500
        && data.status in ['active', 'completed', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'adviceMessage', 4000)
        && (!('availableDays' in data) || (data.availableDays is list && data.availableDays.size() <= 7 && (data.availableDays.size() == 0 || data.availableDays[0] is string)))
        && (!('hardSubjects' in data) || (data.hardSubjects is list && data.hardSubjects.size() <= 20 && (data.hardSubjects.size() == 0 || data.hardSubjects[0] is string)))
        && (!('bookIds' in data) || (data.bookIds is list && data.bookIds.size() <= 30 && (data.bookIds.size() == 0 || data.bookIds[0] is string)));
    }

    function isValidStudyTask(data, userId, planId, taskId) {
      return data.id is string
        && data.id == taskId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.planId is string
        && data.planId == planId
        && isValidId(data.planId)
        && data.date is string
        && data.date.size() >= 8
        && data.date.size() <= 20
        && data.bookId is string
        && isValidId(data.bookId)
        && data.bookTitle is string
        && data.bookTitle.size() >= 1
        && data.bookTitle.size() <= 240
        && data.startPage is int
        && data.startPage >= 1
        && data.endPage is int
        && data.endPage >= data.startPage
        && data.estimatedMinutes is int
        && data.estimatedMinutes >= 5
        && data.estimatedMinutes <= 600
        && data.taskType in ['study', 'review', 'quiz', 'rest']
        && data.status in ['pending', 'in_progress', 'completed', 'skipped']
        && data.orderIndex is int
        && data.orderIndex >= 0
        && data.updatedAt is timestamp
        && isOptionalString(data, 'subject', 120)
        && isOptionalString(data, 'chapterTitle', 200)
        && (!('actualMinutes' in data) || (data.actualMinutes is int && data.actualMinutes >= 0 && data.actualMinutes <= 1000))
        && (!('difficulty' in data) || data.difficulty in ['easy', 'medium', 'hard']);
    }

    function isValidExam(data, userId, examId) {
      return data.id is string
        && data.id == examId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.bookId is string
        && isValidId(data.bookId)
        && data.bookTitle is string
        && data.bookTitle.size() >= 1
        && data.bookTitle.size() <= 240
        && data.scopeLabel is string
        && data.scopeLabel.size() >= 1
        && data.scopeLabel.size() <= 240
        && data.startPage is int
        && data.startPage >= 1
        && data.endPage is int
        && data.endPage >= data.startPage
        && data.mode in ['written', 'oral']
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.selectionStrategy in ['comprehensive', 'important', 'random']
        && data.evaluationMode in ['practice', 'exam']
        && data.totalQuestions is int
        && data.totalQuestions >= 1
        && data.totalQuestions <= 100
        && (data.score is float || data.score is int)
        && data.score >= 0
        && data.score <= 100
        && data.status in ['in_progress', 'completed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'coverageWarning', 500)
        && (!('durationMinutes' in data) || (data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 300))
        && (!('weakTopics' in data) || (data.weakTopics is list && data.weakTopics.size() <= 30 && (data.weakTopics.size() == 0 || data.weakTopics[0] is string)));
    }

    function isValidExamQuestion(data, userId, examId, questionId) {
      return data.id is string
        && data.id == questionId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.examId is string
        && data.examId == examId
        && isValidId(data.examId)
        && data.orderIndex is int
        && data.orderIndex >= 0
        && data.orderIndex <= 100
        && data.questionType in ['mcq', 'true_false', 'definition', 'reasoning', 'fill_blank', 'comparison', 'essay', 'math', 'diagram']
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 4000
        && data.correctAnswer is string
        && data.correctAnswer.size() >= 1
        && data.correctAnswer.size() <= 4000
        && (data.maxPoints is float || data.maxPoints is int)
        && data.maxPoints > 0
        && data.maxPoints <= 100
        && data.sourcePage is int
        && data.sourcePage >= 1
        && data.updatedAt is timestamp
        && isOptionalString(data, 'studentAnswer', 4000)
        && isOptionalString(data, 'transcript', 4000)
        && isOptionalString(data, 'mistakeReason', 2000)
        && isOptionalString(data, 'explanation', 4000)
        && isOptionalString(data, 'topicTitle', 200)
        && (!('isCorrect' in data) || data.isCorrect is bool)
        && (!('earnedPoints' in data) || ((data.earnedPoints is float || data.earnedPoints is int) && data.earnedPoints >= 0 && data.earnedPoints <= data.maxPoints))
        && (!('options' in data) || (data.options is list && data.options.size() <= 10 && (data.options.size() == 0 || data.options[0] is string)));
    }

    function isValidSchoolGrade(data, userId, gradeId) {
      return data.id is string
        && data.id == gradeId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 120
        && data.examType in ['daily', 'month1', 'month2', 'midyear', 'final', 'other']
        && data.examLabel is string
        && data.examLabel.size() >= 1
        && data.examLabel.size() <= 160
        && (data.score is float || data.score is int)
        && data.score >= 0
        && (data.maxScore is float || data.maxScore is int)
        && data.maxScore >= 1
        && data.maxScore <= 1000
        && data.score <= data.maxScore
        && (data.percentage is float || data.percentage is int)
        && data.percentage >= 0
        && data.percentage <= 100
        && data.examDate is string
        && data.examDate.size() >= 8
        && data.examDate.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'chapterOrTopic', 200)
        && isOptionalString(data, 'notes', 1000)
        && (!('bookId' in data) || isValidId(data.bookId));
    }

    // Student Profile (Strict PII isolation: owner only, no listing)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().keys().hasAll(['uid', 'email', 'tutorLanguage', 'theme', 'fontSize', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'tutorLanguage', 'theme', 'fontSize', 'speechRate', 'voiceName', 'gradeLevel', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'tutorLanguage', 'theme', 'fontSize', 'speechRate', 'voiceName', 'gradeLevel', 'updatedAt'])
        );
      allow delete: if isOwner(userId) && isValidId(userId);

      // Student Books
      match /books/{bookId} {
        allow get: if isOwner(userId) && isValidId(bookId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(bookId)
          && incoming().keys().hasAll(['id', 'userId', 'title', 'fileType', 'totalPages', 'lastPage', 'completedCount', 'analyzedCount', 'analysisStatus', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'userId', 'title', 'subject', 'gradeLevel', 'fileType', 'totalPages', 'lastPage', 'completedCount', 'analyzedCount', 'analysisStatus', 'coverImage', 'chapters', 'importantTasks', 'createdAt', 'updatedAt'])
          && isValidBook(incoming(), userId, bookId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(bookId)
          && isValidBook(incoming(), userId, bookId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Rename / edit book details
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subject', 'gradeLevel', 'coverImage', 'updatedAt'])
            // Action: Update reading progress
            || incoming().diff(existing()).affectedKeys().hasOnly(['lastPage', 'completedCount', 'updatedAt'])
            // Action: Update analysis metadata & TOC
            || incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'gradeLevel', 'analyzedCount', 'analysisStatus', 'chapters', 'importantTasks', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(bookId);

        // Book Pages
        match /pages/{pageId} {
          allow get: if isOwner(userId) && isValidId(bookId) && isValidId(pageId);
          allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(bookId)
            && isValidId(pageId)
            && exists(/databases/$(database)/documents/users/$(userId)/books/$(bookId))
            && incoming().keys().hasAll(['pageNumber', 'userId', 'bookId', 'extractedText', 'isCompleted', 'isAnalyzed', 'updatedAt'])
            && incoming().keys().hasOnly(['pageNumber', 'userId', 'bookId', 'printedPageLabel', 'chapterTitle', 'imageData', 'extractedText', 'concepts', 'diagrams', 'equations', 'difficulty', 'estimatedMinutes', 'isCompleted', 'isAnalyzed', 'ocrApplied', 'updatedAt'])
            && isValidBookPage(incoming(), userId, bookId)
            && incoming().updatedAt == request.time;
          allow update: if isOwner(userId)
            && isValidId(bookId)
            && isValidId(pageId)
            && isValidBookPage(incoming(), userId, bookId)
            && incoming().userId == existing().userId
            && incoming().bookId == existing().bookId
            && incoming().pageNumber == existing().pageNumber
            && incoming().updatedAt == request.time
            && (
              // Action: Mark page completed
              incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'updatedAt'])
              // Action: Save AI analysis or OCR update
              || incoming().diff(existing()).affectedKeys().hasOnly(['printedPageLabel', 'chapterTitle', 'extractedText', 'concepts', 'diagrams', 'equations', 'difficulty', 'estimatedMinutes', 'isAnalyzed', 'ocrApplied', 'imageData', 'updatedAt'])
            );
          allow delete: if isOwner(userId) && isValidId(bookId) && isValidId(pageId);
        }

        // Book Chat Messages
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(bookId) && isValidId(messageId);
          allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(bookId)
            && isValidId(messageId)
            && exists(/databases/$(database)/documents/users/$(userId)/books/$(bookId))
            && incoming().keys().hasAll(['id', 'userId', 'bookId', 'role', 'text', 'pageNumber', 'createdAt'])
            && incoming().keys().hasOnly(['id', 'userId', 'bookId', 'role', 'text', 'pageNumber', 'chapterTitle', 'selectedText', 'createdAt'])
            && isValidChatMessage(incoming(), userId, bookId, messageId)
            && incoming().createdAt == request.time;
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(bookId) && isValidId(messageId);
        }
      }

      // Personal Notes
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && incoming().keys().hasAll(['id', 'userId', 'bookId', 'bookTitle', 'pageNumber', 'noteType', 'title', 'content', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'userId', 'bookId', 'bookTitle', 'chapterTitle', 'pageNumber', 'noteType', 'title', 'selectedText', 'content', 'createdAt', 'updatedAt'])
          && isValidNote(incoming(), userId, noteId)
          && exists(/databases/$(database)/documents/users/$(userId)/books/$(incoming().bookId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && isValidNote(incoming(), userId, noteId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Study Plans
      match /studyPlans/{planId} {
        allow get: if isOwner(userId) && isValidId(planId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(planId)
          && incoming().keys().hasAll(['id', 'userId', 'title', 'startDate', 'examDate', 'dailyHours', 'studyMode', 'totalTasks', 'completedTasks', 'status', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'userId', 'title', 'startDate', 'examDate', 'dailyHours', 'availableDays', 'hardSubjects', 'studyMode', 'bookIds', 'totalTasks', 'completedTasks', 'adviceMessage', 'status', 'createdAt', 'updatedAt'])
          && isValidStudyPlan(incoming(), userId, planId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(planId)
          && isValidStudyPlan(incoming(), userId, planId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'examDate', 'dailyHours', 'availableDays', 'totalTasks', 'completedTasks', 'adviceMessage', 'status', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(planId);

        match /tasks/{taskId} {
          allow get: if isOwner(userId) && isValidId(planId) && isValidId(taskId);
          allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(planId)
            && isValidId(taskId)
            && exists(/databases/$(database)/documents/users/$(userId)/studyPlans/$(planId))
            && incoming().keys().hasAll(['id', 'userId', 'planId', 'date', 'bookId', 'bookTitle', 'startPage', 'endPage', 'estimatedMinutes', 'taskType', 'status', 'orderIndex', 'updatedAt'])
            && incoming().keys().hasOnly(['id', 'userId', 'planId', 'date', 'bookId', 'bookTitle', 'subject', 'chapterTitle', 'startPage', 'endPage', 'estimatedMinutes', 'actualMinutes', 'taskType', 'difficulty', 'status', 'orderIndex', 'updatedAt'])
            && isValidStudyTask(incoming(), userId, planId, taskId)
            && incoming().updatedAt == request.time;
          allow update: if isOwner(userId)
            && isValidId(planId)
            && isValidId(taskId)
            && isValidStudyTask(incoming(), userId, planId, taskId)
            && incoming().id == existing().id
            && incoming().userId == existing().userId
            && incoming().planId == existing().planId
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'actualMinutes', 'date', 'estimatedMinutes', 'orderIndex', 'updatedAt'])
            );
          allow delete: if isOwner(userId) && isValidId(planId) && isValidId(taskId);
        }
      }

      // Exams
      match /exams/{examId} {
        allow get: if isOwner(userId) && isValidId(examId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(examId)
          && incoming().keys().hasAll(['id', 'userId', 'bookId', 'bookTitle', 'scopeLabel', 'startPage', 'endPage', 'mode', 'difficulty', 'selectionStrategy', 'evaluationMode', 'totalQuestions', 'score', 'status', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'userId', 'bookId', 'bookTitle', 'scopeLabel', 'startPage', 'endPage', 'mode', 'difficulty', 'selectionStrategy', 'evaluationMode', 'durationMinutes', 'totalQuestions', 'score', 'status', 'weakTopics', 'coverageWarning', 'createdAt', 'updatedAt'])
          && isValidExam(incoming(), userId, examId)
          && exists(/databases/$(database)/documents/users/$(userId)/books/$(incoming().bookId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(examId)
          && existing().status != 'completed'
          && isValidExam(incoming(), userId, examId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['score', 'status', 'weakTopics', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(examId);

        match /questions/{questionId} {
          allow get: if isOwner(userId) && isValidId(examId) && isValidId(questionId);
          allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(examId)
            && isValidId(questionId)
            && exists(/databases/$(database)/documents/users/$(userId)/exams/$(examId))
            && incoming().keys().hasAll(['id', 'userId', 'examId', 'orderIndex', 'questionType', 'prompt', 'correctAnswer', 'maxPoints', 'sourcePage', 'updatedAt'])
            && incoming().keys().hasOnly(['id', 'userId', 'examId', 'orderIndex', 'questionType', 'prompt', 'options', 'correctAnswer', 'studentAnswer', 'transcript', 'isCorrect', 'earnedPoints', 'maxPoints', 'mistakeReason', 'explanation', 'sourcePage', 'topicTitle', 'updatedAt'])
            && isValidExamQuestion(incoming(), userId, examId, questionId)
            && incoming().updatedAt == request.time;
          allow update: if isOwner(userId)
            && isValidId(examId)
            && isValidId(questionId)
            && isValidExamQuestion(incoming(), userId, examId, questionId)
            && incoming().id == existing().id
            && incoming().userId == existing().userId
            && incoming().examId == existing().examId
            && incoming().updatedAt == request.time
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['studentAnswer', 'transcript', 'isCorrect', 'earnedPoints', 'mistakeReason', 'explanation', 'updatedAt'])
            );
          allow delete: if isOwner(userId) && isValidId(examId) && isValidId(questionId);
        }
      }

      // Real School Class Grades Record (سجل درجات الصف)
      match /schoolGrades/{gradeId} {
        allow get: if isOwner(userId) && isValidId(gradeId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(gradeId)
          && incoming().keys().hasAll(['id', 'userId', 'subject', 'examType', 'examLabel', 'score', 'maxScore', 'percentage', 'examDate', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'userId', 'subject', 'examType', 'examLabel', 'score', 'maxScore', 'percentage', 'chapterOrTopic', 'bookId', 'examDate', 'notes', 'createdAt', 'updatedAt'])
          && isValidSchoolGrade(incoming(), userId, gradeId)
          && (!('bookId' in incoming()) || exists(/databases/$(database)/documents/users/$(userId)/books/$(incoming().bookId)))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(gradeId)
          && isValidSchoolGrade(incoming(), userId, gradeId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (!('bookId' in incoming()) || exists(/databases/$(database)/documents/users/$(userId)/books/$(incoming().bookId)))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'examType', 'examLabel', 'score', 'maxScore', 'percentage', 'chapterOrTopic', 'bookId', 'examDate', 'notes', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(gradeId);
      }
    }

    // === Smart Student Record (سجل الطالب الذكي) ===
    function isSchoolOwnerDoc(schoolId) {
      return isVerifiedUser()
        && isValidId(schoolId)
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid;
    }

    function hasSchoolMemberDoc(schoolId) {
      return isVerifiedUser()
        && isValidId(schoolId)
        && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid));
    }

    function getSchoolMember(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data;
    }

    function isSchoolAdminMember(schoolId) {
      return isSchoolOwnerDoc(schoolId)
        || (hasSchoolMemberDoc(schoolId)
          && getSchoolMember(schoolId).status == 'active'
          && getSchoolMember(schoolId).role == 'admin');
    }

    function isSectionCounselorMember(schoolId, sectionId) {
      return hasSchoolMemberDoc(schoolId)
        && getSchoolMember(schoolId).status == 'active'
        && getSchoolMember(schoolId).role == 'counselor'
        && getSchoolMember(schoolId).sectionId == sectionId;
    }

    function isSelfStudentMember(schoolId, studentId) {
      return hasSchoolMemberDoc(schoolId)
        && getSchoolMember(schoolId).status == 'active'
        && getSchoolMember(schoolId).role == 'student'
        && getSchoolMember(schoolId).studentId == studentId;
    }

    function isValidSchoolRecord(data, schoolId) {
      return data.id is string
        && data.id == schoolId
        && isValidId(data.id)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && data.academicYear is string
        && data.academicYear.size() >= 1
        && data.academicYear.size() <= 40
        && data.directorate is string
        && data.directorate.size() >= 1
        && data.directorate.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'logoDataUrl', 350000)
        && isOptionalString(data, 'coverDataUrl', 450000)
        && isOptionalString(data, 'overview', 4000)
        && isOptionalString(data, 'vision', 2000)
        && isOptionalString(data, 'mission', 2000)
        && (!('goals' in data) || (data.goals is list && data.goals.size() <= 30 && (data.goals.size() == 0 || data.goals[0] is string)));
    }

    function isValidSchoolMember(data, schoolId, memberUid) {
      return data.uid is string
        && data.uid == memberUid
        && isValidId(data.uid)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.role in ['admin', 'counselor', 'student']
        && data.status in ['active', 'revoked']
        && data.updatedAt is timestamp
        && isOptionalString(data, 'sectionId', 128)
        && isOptionalString(data, 'studentId', 128)
        && isOptionalString(data, 'displayName', 160);
    }

    function isValidSchoolAnnouncement(data, schoolId, announcementId) {
      return data.id is string
        && data.id == announcementId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 4000
        && data.pinned is bool
        && data.visibility in ['public', 'internal']
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchoolStage(data, schoolId, stageId) {
      return data.id is string
        && data.id == stageId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.orderIndex is int
        && data.orderIndex >= 0
        && data.orderIndex <= 200
        && data.updatedAt is timestamp;
    }

    function isValidSchoolSection(data, schoolId, sectionId) {
      return data.id is string
        && data.id == sectionId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.stageId is string
        && isValidId(data.stageId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.counselorName is string
        && data.counselorName.size() <= 160
        && data.counselorCodeStatus in ['active', 'revoked', 'unset']
        && data.orderIndex is int
        && data.orderIndex >= 0
        && data.orderIndex <= 500
        && data.updatedAt is timestamp;
    }

    function isValidSchoolStudent(data, schoolId, studentId) {
      return data.id is string
        && data.id == studentId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.sectionId is string
        && isValidId(data.sectionId)
        && data.fullName is string
        && data.fullName.size() >= 1
        && data.fullName.size() <= 160
        && data.status in ['active', 'inactive', 'transferred']
        && data.studentCodeStatus in ['active', 'revoked', 'unset']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'notes', 1000);
    }

    function isValidSchoolAbsence(data, schoolId, absenceId) {
      return data.id is string
        && data.id == absenceId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.sectionId is string
        && isValidId(data.sectionId)
        && data.studentId is string
        && isValidId(data.studentId)
        && data.date is string
        && data.date.size() >= 8
        && data.date.size() <= 20
        && data.excuseType in ['excused', 'unexcused', 'medical', 'official']
        && data.recordedBy is string
        && data.recordedBy.size() >= 1
        && data.recordedBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'subjectName', 120)
        && isOptionalString(data, 'notes', 1000);
    }

    function isValidSchoolSubject(data, schoolId, subjectId) {
      return data.id is string
        && data.id == subjectId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.sectionId is string
        && isValidId(data.sectionId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 350000
        && data.updatedAt is timestamp;
    }

    function isValidSchoolTemplate(data, schoolId, templateId) {
      return data.id is string
        && data.id == templateId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 160
        && data.boxesJson is string
        && data.boxesJson.size() >= 2
        && data.boxesJson.size() <= 60000
        && data.createdAt is timestamp
        && isOptionalString(data, 'description', 1000);
    }

    function isValidSchoolAuditLog(data, schoolId, logId) {
      return data.id is string
        && data.id == logId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.actorName is string
        && data.actorName.size() >= 1
        && data.actorName.size() <= 160
        && data.actorRole in ['admin', 'counselor', 'student', 'system']
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 160
        && data.targetType is string
        && data.targetType.size() >= 1
        && data.targetType.size() <= 80
        && data.targetId is string
        && data.targetId.size() <= 128
        && data.targetLabel is string
        && data.targetLabel.size() <= 200
        && data.prevValue is string
        && data.prevValue.size() <= 4000
        && data.nextValue is string
        && data.nextValue.size() <= 4000
        && data.timestamp is timestamp;
    }

    function isValidHex64(s) {
      return s is string && s.size() == 64 && s.matches('^[a-f0-9]{64}$');
    }

    function isEmptyOrHex64(s) {
      return s is string && (s == '' || isValidHex64(s));
    }

    function isStringMax(s, maxLen) {
      return s is string && s.size() <= maxLen;
    }

    function isValidSchoolPublicInfo(data, schoolId, docId) {
      return docId == 'info'
        && data.id is string
        && data.id == 'info'
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 200
        && data.academicYear is string
        && data.academicYear.size() >= 1
        && data.academicYear.size() <= 40
        && data.directorate is string
        && data.directorate.size() >= 1
        && data.directorate.size() <= 160
        && isOptionalString(data, 'logoDataUrl', 350000)
        && isOptionalString(data, 'coverDataUrl', 450000)
        && isOptionalString(data, 'overview', 4000)
        && isOptionalString(data, 'vision', 2000)
        && isOptionalString(data, 'mission', 2000)
        && (!('goals' in data) || (data.goals is list && data.goals.size() <= 30 && (data.goals.size() == 0 || data.goals[0] is string)))
        && (!('announcements' in data) || (data.announcements is list && data.announcements.size() <= 100 && (data.announcements.size() == 0 || data.announcements[0] is map)))
        && data.stagesCount is int
        && data.stagesCount >= 0
        && data.stagesCount <= 200
        && data.sectionsCount is int
        && data.sectionsCount >= 0
        && data.sectionsCount <= 500
        && data.adminCodeConfigured is bool
        && data.updatedAt is timestamp;
    }

    function isValidSchoolAdminSecurity(data, schoolId, docId) {
      return docId == 'config'
        && data.id is string
        && data.id == 'config'
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.hash is string
        && data.hash.size() >= 64
        && data.hash.size() <= 128
        && data.hash.matches('^[a-f0-9]{64,128}$')
        && data.salt is string
        && data.salt.size() >= 16
        && data.salt.size() <= 64
        && data.salt.matches('^[a-f0-9]{16,64}$')
        && data.iterations is int
        && data.iterations >= 10000
        && data.iterations <= 1000000
        && data.updatedAt is timestamp;
    }

    function isValidSchoolSectionLock(data, schoolId, sectionId) {
      return data.id is string
        && data.id == sectionId
        && isValidId(data.id)
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.sectionId is string
        && data.sectionId == sectionId
        && isEmptyOrHex64(data.counselorCodeHash)
        && isEmptyOrHex64(data.sectionCapKey)
        && data.updatedAt is timestamp;
    }

    function isValidSchoolAccessLookup(data, schoolId, codeHash) {
      return isValidHex64(codeHash)
        && data.codeHash is string
        && data.codeHash == codeHash
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.role in ['admin_gate', 'counselor', 'student']
        && isStringMax(data.sectionId, 128)
        && isStringMax(data.studentId, 128)
        && isEmptyOrHex64(data.capabilityKey)
        && isStringMax(data.displayName, 160)
        && isStringMax(data.sectionName, 160)
        && isStringMax(data.stageName, 160)
        && data.status in ['active', 'revoked']
        && data.updatedAt is timestamp;
    }

    function isValidSchoolCapSection(data, schoolId, capKey) {
      return isValidHex64(capKey)
        && data.capKey is string
        && data.capKey == capKey
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.sectionId is string
        && isValidId(data.sectionId)
        && data.stageId is string
        && isValidId(data.stageId)
        && isEmptyOrHex64(data.counselorCodeHash)
        && data.school is map
        && data.stages is list
        && data.stages.size() <= 200
        && (data.stages.size() == 0 || data.stages[0] is map)
        && data.announcements is list
        && data.announcements.size() <= 150
        && (data.announcements.size() == 0 || data.announcements[0] is map)
        && data.section is map
        && data.students is list
        && data.students.size() <= 400
        && (data.students.size() == 0 || data.students[0] is map)
        && data.absences is list
        && data.absences.size() <= 1000
        && (data.absences.size() == 0 || data.absences[0] is map)
        && data.subjects is list
        && data.subjects.size() <= 150
        && (data.subjects.size() == 0 || data.subjects[0] is map)
        && data.templates is list
        && data.templates.size() <= 100
        && (data.templates.size() == 0 || data.templates[0] is map)
        && data.pendingAuditLogs is list
        && data.pendingAuditLogs.size() <= 400
        && (data.pendingAuditLogs.size() == 0 || data.pendingAuditLogs[0] is map)
        && data.announcementReads is map
        && isStringMax(data.counselorEditedAt, 40)
        && data.updatedAt is timestamp;
    }

    function isValidSchoolCapStudent(data, schoolId, capKey) {
      return isValidHex64(capKey)
        && data.capKey is string
        && data.capKey == capKey
        && data.schoolId is string
        && data.schoolId == schoolId
        && isValidId(data.schoolId)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && data.sectionId is string
        && isValidId(data.sectionId)
        && data.studentId is string
        && isValidId(data.studentId)
        && data.school is map
        && data.stages is list
        && data.stages.size() <= 200
        && (data.stages.size() == 0 || data.stages[0] is map)
        && data.section is map
        && data.student is map
        && data.absences is list
        && data.absences.size() <= 400
        && (data.absences.size() == 0 || data.absences[0] is map)
        && data.subjects is list
        && data.subjects.size() <= 150
        && (data.subjects.size() == 0 || data.subjects[0] is map)
        && data.announcements is list
        && data.announcements.size() <= 150
        && (data.announcements.size() == 0 || data.announcements[0] is map)
        && data.updatedAt is timestamp;
    }

    function isCounselorAtomicSectionWrite(schoolId, sectionId, targetOwnerUid) {
      return isValidId(schoolId)
        && isValidId(sectionId)
        && exists(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId))
        && get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.ownerUid == targetOwnerUid
        && isValidHex64(get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.counselorCodeHash)
        && isValidHex64(get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.sectionCapKey)
        && exists(/databases/$(database)/documents/schools/$(schoolId)/capSections/$(get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.sectionCapKey))
        && get(/databases/$(database)/documents/schools/$(schoolId)/capSections/$(get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.sectionCapKey)).data.counselorCodeHash == get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.counselorCodeHash
        && getAfter(/databases/$(database)/documents/schools/$(schoolId)/capSections/$(get(/databases/$(database)/documents/schools/$(schoolId)/sectionLocks/$(sectionId)).data.sectionCapKey)).data.updatedAt == request.time;
    }

    match /schools/{schoolId} {
      allow get: if isValidId(schoolId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isSchoolAdminMember(schoolId));
      allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(schoolId)
        && incoming().ownerUid == request.auth.uid
        && incoming().keys().hasAll(['id', 'ownerUid', 'name', 'academicYear', 'directorate', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'ownerUid', 'name', 'academicYear', 'directorate', 'logoDataUrl', 'coverDataUrl', 'overview', 'vision', 'mission', 'goals', 'createdAt', 'updatedAt'])
        && isValidSchoolRecord(incoming(), schoolId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(schoolId)
        && existing().ownerUid == request.auth.uid
        && isValidSchoolRecord(incoming(), schoolId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'academicYear', 'directorate', 'logoDataUrl', 'coverDataUrl', 'overview', 'vision', 'mission', 'goals', 'updatedAt'])
        );
      allow delete: if isVerifiedUser() && isValidId(schoolId) && existing().ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isValidId(schoolId)
          && isValidId(memberUid)
          && isVerifiedUser()
          && (request.auth.uid == memberUid || isSchoolAdminMember(schoolId));
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isSchoolOwnerDoc(schoolId)
          && isValidId(memberUid)
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['uid', 'schoolId', 'ownerUid', 'role', 'status', 'updatedAt'])
          && incoming().keys().hasOnly(['uid', 'schoolId', 'ownerUid', 'role', 'sectionId', 'studentId', 'displayName', 'status', 'updatedAt'])
          && isValidSchoolMember(incoming(), schoolId, memberUid)
          && incoming().updatedAt == request.time;
        allow update: if isSchoolOwnerDoc(schoolId)
          && isValidId(memberUid)
          && isValidSchoolMember(incoming(), schoolId, memberUid)
          && incoming().uid == existing().uid
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'sectionId', 'studentId', 'displayName', 'status', 'updatedAt'])
          );
        allow delete: if isSchoolOwnerDoc(schoolId) && isValidId(memberUid);
      }

      match /announcements/{announcementId} {
        allow get: if isValidId(schoolId)
          && isValidId(announcementId)
          && isVerifiedUser()
          && (isSchoolAdminMember(schoolId) || hasSchoolMemberDoc(schoolId));
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isSchoolAdminMember(schoolId)
          && isValidId(announcementId)
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'title', 'body', 'pinned', 'visibility', 'authorName', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'title', 'body', 'pinned', 'visibility', 'authorName', 'createdAt', 'updatedAt'])
          && isValidSchoolAnnouncement(incoming(), schoolId, announcementId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSchoolAdminMember(schoolId)
          && isValidId(announcementId)
          && isValidSchoolAnnouncement(incoming(), schoolId, announcementId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'pinned', 'visibility', 'authorName', 'updatedAt'])
          );
        allow delete: if isSchoolAdminMember(schoolId) && isValidId(announcementId);
      }

      match /stages/{stageId} {
        allow get: if isValidId(schoolId)
          && isValidId(stageId)
          && isVerifiedUser()
          && (isSchoolAdminMember(schoolId) || hasSchoolMemberDoc(schoolId));
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isSchoolAdminMember(schoolId)
          && isValidId(stageId)
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'name', 'orderIndex', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'name', 'orderIndex', 'updatedAt'])
          && isValidSchoolStage(incoming(), schoolId, stageId)
          && incoming().updatedAt == request.time;
        allow update: if isSchoolAdminMember(schoolId)
          && isValidId(stageId)
          && isValidSchoolStage(incoming(), schoolId, stageId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'orderIndex', 'updatedAt'])
          );
        allow delete: if isSchoolAdminMember(schoolId) && isValidId(stageId);
      }

      match /sections/{sectionId} {
        allow get: if isValidId(schoolId)
          && isValidId(sectionId)
          && isVerifiedUser()
          && (isSchoolAdminMember(schoolId) || isSectionCounselorMember(schoolId, sectionId));
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isSchoolAdminMember(schoolId)
          && isValidId(sectionId)
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'stageId', 'name', 'counselorName', 'counselorCodeStatus', 'orderIndex', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'stageId', 'name', 'counselorName', 'counselorCodeStatus', 'orderIndex', 'updatedAt'])
          && isValidSchoolSection(incoming(), schoolId, sectionId)
          && incoming().updatedAt == request.time;
        allow update: if isSchoolAdminMember(schoolId)
          && isValidId(sectionId)
          && isValidSchoolSection(incoming(), schoolId, sectionId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['stageId', 'name', 'counselorName', 'counselorCodeStatus', 'orderIndex', 'updatedAt'])
          );
        allow delete: if isSchoolAdminMember(schoolId) && isValidId(sectionId);
      }

      match /students/{studentId} {
        allow get: if isValidId(schoolId)
          && isValidId(studentId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
            || isSelfStudentMember(schoolId, studentId)
          );
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(studentId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, incoming().sectionId)
          )
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'sectionId', 'fullName', 'status', 'studentCodeStatus', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'sectionId', 'fullName', 'status', 'studentCodeStatus', 'notes', 'createdAt', 'updatedAt'])
          && isValidSchoolStudent(incoming(), schoolId, studentId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(studentId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          )
          && isValidSchoolStudent(incoming(), schoolId, studentId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().sectionId == existing().sectionId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'status', 'studentCodeStatus', 'notes', 'updatedAt'])
          );
        allow delete: if isValidId(studentId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          );
      }

      match /absences/{absenceId} {
        allow get: if isValidId(schoolId)
          && isValidId(absenceId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
            || isSelfStudentMember(schoolId, existing().studentId)
          );
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(absenceId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, incoming().sectionId)
          )
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'sectionId', 'studentId', 'date', 'excuseType', 'recordedBy', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'sectionId', 'studentId', 'date', 'excuseType', 'subjectName', 'notes', 'recordedBy', 'createdAt', 'updatedAt'])
          && isValidSchoolAbsence(incoming(), schoolId, absenceId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(absenceId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          )
          && isValidSchoolAbsence(incoming(), schoolId, absenceId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().sectionId == existing().sectionId
          && incoming().studentId == existing().studentId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['date', 'excuseType', 'subjectName', 'notes', 'recordedBy', 'updatedAt'])
          );
        allow delete: if isValidId(absenceId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          );
      }

      match /subjects/{subjectId} {
        allow get: if isValidId(schoolId)
          && isValidId(subjectId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          );
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(subjectId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, incoming().sectionId)
          )
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'sectionId', 'name', 'payloadJson', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'sectionId', 'name', 'payloadJson', 'updatedAt'])
          && isValidSchoolSubject(incoming(), schoolId, subjectId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(subjectId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          )
          && isValidSchoolSubject(incoming(), schoolId, subjectId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().sectionId == existing().sectionId
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'payloadJson', 'updatedAt'])
          );
        allow delete: if isValidId(subjectId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || isSectionCounselorMember(schoolId, existing().sectionId)
          );
      }

      match /templates/{templateId} {
        allow get: if isValidId(schoolId)
          && isValidId(templateId)
          && isVerifiedUser()
          && (isSchoolAdminMember(schoolId) || hasSchoolMemberDoc(schoolId));
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(templateId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || (hasSchoolMemberDoc(schoolId) && getSchoolMember(schoolId).status == 'active' && getSchoolMember(schoolId).role == 'counselor')
          )
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'name', 'boxesJson', 'createdAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'name', 'description', 'boxesJson', 'createdAt'])
          && isValidSchoolTemplate(incoming(), schoolId, templateId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(templateId)
          && isVerifiedUser()
          && isSchoolAdminMember(schoolId);
      }

      match /auditLogs/{logId} {
        allow get: if isValidId(schoolId) && isValidId(logId) && isSchoolAdminMember(schoolId);
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(logId)
          && isVerifiedUser()
          && (
            isSchoolAdminMember(schoolId)
            || (hasSchoolMemberDoc(schoolId) && getSchoolMember(schoolId).status == 'active' && getSchoolMember(schoolId).role == 'counselor')
          )
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'actorName', 'actorRole', 'action', 'targetType', 'targetId', 'targetLabel', 'prevValue', 'nextValue', 'timestamp'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'actorName', 'actorRole', 'action', 'targetType', 'targetId', 'targetLabel', 'prevValue', 'nextValue', 'timestamp'])
          && isValidSchoolAuditLog(incoming(), schoolId, logId)
          && incoming().timestamp == request.time;
        allow update, delete: if false;
      }

      match /public/{docId} {
        allow get: if isValidId(schoolId) && docId == 'info';
        allow list: if false;
        allow create: if isSchoolAdminMember(schoolId)
          && docId == 'info'
          && incoming().keys().hasAll(['id', 'schoolId', 'name', 'academicYear', 'directorate', 'stagesCount', 'sectionsCount', 'adminCodeConfigured', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'name', 'academicYear', 'directorate', 'logoDataUrl', 'coverDataUrl', 'overview', 'vision', 'mission', 'goals', 'announcements', 'stagesCount', 'sectionsCount', 'adminCodeConfigured', 'updatedAt'])
          && isValidSchoolPublicInfo(incoming(), schoolId, docId)
          && incoming().updatedAt == request.time;
        allow update: if isSchoolAdminMember(schoolId)
          && docId == 'info'
          && incoming().keys().hasAll(['id', 'schoolId', 'name', 'academicYear', 'directorate', 'stagesCount', 'sectionsCount', 'adminCodeConfigured', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'name', 'academicYear', 'directorate', 'logoDataUrl', 'coverDataUrl', 'overview', 'vision', 'mission', 'goals', 'announcements', 'stagesCount', 'sectionsCount', 'adminCodeConfigured', 'updatedAt'])
          && isValidSchoolPublicInfo(incoming(), schoolId, docId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'academicYear', 'directorate', 'logoDataUrl', 'coverDataUrl', 'overview', 'vision', 'mission', 'goals', 'announcements', 'stagesCount', 'sectionsCount', 'adminCodeConfigured', 'updatedAt']);
        allow delete: if isSchoolAdminMember(schoolId) && docId == 'info';
      }

      match /adminSecurity/{docId} {
        allow get: if isValidId(schoolId) && docId == 'config' && isSchoolAdminMember(schoolId);
        allow list: if false;
        allow create: if isSchoolAdminMember(schoolId)
          && docId == 'config'
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'hash', 'salt', 'iterations', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'hash', 'salt', 'iterations', 'updatedAt'])
          && isValidSchoolAdminSecurity(incoming(), schoolId, docId)
          && incoming().updatedAt == request.time;
        allow update: if isSchoolAdminMember(schoolId)
          && docId == 'config'
          && isValidSchoolAdminSecurity(incoming(), schoolId, docId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['hash', 'salt', 'iterations', 'updatedAt']);
        allow delete: if false;
      }

      match /sectionLocks/{sectionId} {
        allow get: if isValidId(schoolId) && isValidId(sectionId) && isSchoolAdminMember(schoolId);
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isSchoolAdminMember(schoolId)
          && isValidId(sectionId)
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['id', 'schoolId', 'ownerUid', 'sectionId', 'counselorCodeHash', 'sectionCapKey', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'schoolId', 'ownerUid', 'sectionId', 'counselorCodeHash', 'sectionCapKey', 'updatedAt'])
          && isValidSchoolSectionLock(incoming(), schoolId, sectionId)
          && incoming().updatedAt == request.time;
        allow update: if isSchoolAdminMember(schoolId)
          && isValidId(sectionId)
          && isValidSchoolSectionLock(incoming(), schoolId, sectionId)
          && incoming().id == existing().id
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().sectionId == existing().sectionId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['counselorCodeHash', 'sectionCapKey', 'updatedAt']);
        allow delete: if isSchoolAdminMember(schoolId) && isValidId(sectionId);
      }

      match /accessLookups/{codeHash} {
        allow get: if isValidId(schoolId) && isValidHex64(codeHash);
        allow list: if false;
        allow create: if isValidId(schoolId)
          && isValidHex64(codeHash)
          && (
            (isSchoolAdminMember(schoolId) && incoming().ownerUid == request.auth.uid)
            || (incoming().role == 'student' && isCounselorAtomicSectionWrite(schoolId, incoming().sectionId, incoming().ownerUid))
          )
          && incoming().keys().hasAll(['codeHash', 'schoolId', 'ownerUid', 'role', 'sectionId', 'studentId', 'capabilityKey', 'displayName', 'sectionName', 'stageName', 'status', 'updatedAt'])
          && incoming().keys().hasOnly(['codeHash', 'schoolId', 'ownerUid', 'role', 'sectionId', 'studentId', 'capabilityKey', 'displayName', 'sectionName', 'stageName', 'status', 'updatedAt'])
          && isValidSchoolAccessLookup(incoming(), schoolId, codeHash)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId)
          && isValidHex64(codeHash)
          && (
            isSchoolAdminMember(schoolId)
            || (existing().role == 'student' && incoming().role == 'student' && isCounselorAtomicSectionWrite(schoolId, existing().sectionId, existing().ownerUid))
          )
          && isValidSchoolAccessLookup(incoming(), schoolId, codeHash)
          && incoming().codeHash == existing().codeHash
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().role == existing().role
          && incoming().sectionId == existing().sectionId
          && incoming().studentId == existing().studentId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['capabilityKey', 'displayName', 'sectionName', 'stageName', 'status', 'updatedAt']);
        allow delete: if isValidId(schoolId)
          && isValidHex64(codeHash)
          && (
            isSchoolAdminMember(schoolId)
            || (existing().role == 'student' && isCounselorAtomicSectionWrite(schoolId, existing().sectionId, existing().ownerUid))
          );
      }

      match /capSections/{capKey} {
        allow get: if isValidId(schoolId) && isValidHex64(capKey);
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isSchoolAdminMember(schoolId)
          && isValidHex64(capKey)
          && incoming().ownerUid == request.auth.uid
          && incoming().keys().hasAll(['capKey', 'schoolId', 'ownerUid', 'sectionId', 'stageId', 'counselorCodeHash', 'school', 'stages', 'announcements', 'section', 'students', 'absences', 'subjects', 'templates', 'pendingAuditLogs', 'announcementReads', 'counselorEditedAt', 'updatedAt'])
          && incoming().keys().hasOnly(['capKey', 'schoolId', 'ownerUid', 'sectionId', 'stageId', 'counselorCodeHash', 'school', 'stages', 'announcements', 'section', 'students', 'absences', 'subjects', 'templates', 'pendingAuditLogs', 'announcementReads', 'counselorEditedAt', 'updatedAt'])
          && isValidSchoolCapSection(incoming(), schoolId, capKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId)
          && isValidHex64(capKey)
          && isValidSchoolCapSection(incoming(), schoolId, capKey)
          && incoming().capKey == existing().capKey
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().sectionId == existing().sectionId
          && incoming().updatedAt == request.time
          && (
            (
              isSchoolAdminMember(schoolId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['stageId', 'counselorCodeHash', 'school', 'stages', 'announcements', 'section', 'students', 'absences', 'subjects', 'templates', 'pendingAuditLogs', 'announcementReads', 'counselorEditedAt', 'updatedAt'])
            )
            || (
              isValidHex64(existing().counselorCodeHash)
              && incoming().stageId == existing().stageId
              && incoming().counselorCodeHash == existing().counselorCodeHash
              && incoming().school == existing().school
              && incoming().stages == existing().stages
              && incoming().announcements == existing().announcements
              && incoming().diff(existing()).affectedKeys().hasOnly(['section', 'students', 'absences', 'subjects', 'templates', 'pendingAuditLogs', 'announcementReads', 'counselorEditedAt', 'updatedAt'])
            )
          );
        allow delete: if isSchoolAdminMember(schoolId) && isValidHex64(capKey);
      }

      match /capStudents/{capKey} {
        allow get: if isValidId(schoolId) && isValidHex64(capKey);
        allow list: if isVerifiedUser() && resource.data.ownerUid == request.auth.uid;
        allow create: if isValidId(schoolId)
          && isValidHex64(capKey)
          && (
            (isSchoolAdminMember(schoolId) && incoming().ownerUid == request.auth.uid)
            || isCounselorAtomicSectionWrite(schoolId, incoming().sectionId, incoming().ownerUid)
          )
          && incoming().keys().hasAll(['capKey', 'schoolId', 'ownerUid', 'sectionId', 'studentId', 'school', 'stages', 'section', 'student', 'absences', 'subjects', 'announcements', 'updatedAt'])
          && incoming().keys().hasOnly(['capKey', 'schoolId', 'ownerUid', 'sectionId', 'studentId', 'school', 'stages', 'section', 'student', 'absences', 'subjects', 'announcements', 'updatedAt'])
          && isValidSchoolCapStudent(incoming(), schoolId, capKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(schoolId)
          && isValidHex64(capKey)
          && (
            isSchoolAdminMember(schoolId)
            || isCounselorAtomicSectionWrite(schoolId, existing().sectionId, existing().ownerUid)
          )
          && isValidSchoolCapStudent(incoming(), schoolId, capKey)
          && incoming().capKey == existing().capKey
          && incoming().schoolId == existing().schoolId
          && incoming().ownerUid == existing().ownerUid
          && incoming().sectionId == existing().sectionId
          && incoming().studentId == existing().studentId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['school', 'stages', 'section', 'student', 'absences', 'subjects', 'announcements', 'updatedAt']);
        allow delete: if isValidId(schoolId)
          && isValidHex64(capKey)
          && (
            isSchoolAdminMember(schoolId)
            || isCounselorAtomicSectionWrite(schoolId, existing().sectionId, existing().ownerUid)
          );
      }
    }
  }
}
